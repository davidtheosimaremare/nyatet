# Telegram Bot Token dari @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Sumopod AI Key dari https://ai.sumopod.com (menu AI -> API Keys)
SUMOPOD_API_KEY=sk-...
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
# Model pilihan di Sumopod (contoh: gpt-4o-mini, gpt-4o, claude-3-5-sonnet, deepseek-chat)
# Catatan: gpt-4o-mini disarankan karena hemat dan mendukung analisis gambar/struk belanja
SUMOPOD_MODEL=gpt-4o-mini

# Transkripsi Voice Note Gratis (Whisper) via Groq dari https://console.groq.com
GROQ_API_KEY=gsk_...

# Google Sheets Spreadsheet ID (ambil dari URL Google Sheet)
# Contoh: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit -> 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
GOOGLE_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
GOOGLE_SHEET_NAME=Pengeluaran

# Kredensial Google Service Account:
# Opsi 1: Path file json (misal ditaruh di root project)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# Opsi 2: Raw string JSON (berguna untuk deploy di cloud PaaS seperti Render/Railway)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Keamanan (Opsional tapi Direkomendasikan):
# Masukkan ID Telegram kamu agar bot hanya merespons kamu (pisahkan koma jika lebih dari satu)
# Jika dikosongkan, bot akan mencetak user ID kamu saat chat pertama kali.
ALLOWED_TELEGRAM_USER_IDS=
